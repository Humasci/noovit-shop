# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Stripe (use test-mode keys sk_test_... until launch) ---
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe (see README)
STRIPE_WEBHOOK_SECRET=
# "true" once Stripe Tax is set up and you have registrations
STRIPE_TAX_ENABLED=false
# Optional: Stripe Tax product codes (look up "dietary supplements" / pet food in Stripe's tax code list)
STRIPE_TAX_CODE_SUPPLEMENTS=
STRIPE_TAX_CODE_PETS=

# --- Supabase (Project settings → API). The service-role key is server-only. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend). Without a key, emails are printed to the server log. ---
RESEND_API_KEY=
EMAIL_FROM=Noovit <orders@noovit.com>

# --- Admin dashboard (/admin) ---
ADMIN_PASSWORD=
# Random string, 32+ characters. Signs admin sessions, "My Subscriptions" links and unsubscribe links. Never change it after launch.
# Generate with: openssl rand -base64 48
APP_SECRET=
# Secret entrance to the admin, e.g. "team-k7q2x9m4". Open https://noovit.com/<ADMIN_PATH> once per browser;
# after that /admin works there. Everyone else gets "page not found" at /admin. Leave empty to disable (local dev).
ADMIN_PATH=

# --- Optional fallbacks (normally set in Admin → Settings, which takes priority) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEWSLETTER_CODE=
BUSINESS_ADDRESS=

# --- Scheduled jobs (Vercel Cron) ---
# Random string; Vercel sends it to /api/cron/daily (review-request emails).
CRON_SECRET=

# --- Klaviyo (optional) ---
# Private API key with lists:write, profiles:write, subscriptions:write, events:write. List ID goes in Admin → Settings.
KLAVIYO_PRIVATE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Label shown on fulfilments (e.g. supliful). Orders are exported by CSV until a direct integration exists.
FULFILMENT_SUPPLIER=manual
