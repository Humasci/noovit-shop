# Copy to .env.local and fill in. Never commit .env.local.

# Stripe (use test-mode keys sk_test_... until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: Stripe Tax product tax codes (look up "dietary supplements" / pet food in Stripe's tax code list)
STRIPE_TAX_CODE_SUPPLEMENTS=
STRIPE_TAX_CODE_PETS=

# Supabase (Project settings -> API). The service-role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
